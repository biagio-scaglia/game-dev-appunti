[gd_scene format=3]

[ext_resource type="Script" path="res://main.gd" id="1_main"]
[ext_resource type="Script" path="res://world/room.gd" id="2_room"]
[ext_resource type="PackedScene" path="res://characters/protagonista/protagonista.tscn" id="3_hero"]
[ext_resource type="AudioStream" path="res://audio/stanza_theme.wav" id="4_theme"]
[ext_resource type="PackedScene" path="res://menu/pause_menu.tscn" id="5_menu"]

[node name="Main" type="Node2D"]
script = ExtResource("1_main")

[node name="Darkness" type="CanvasModulate" parent="."]
color = Color(0.38, 0.36, 0.55, 1)

[node name="World" type="Node2D" parent="."]
y_sort_enabled = true

[node name="Room" type="Node2D" parent="World"]
unique_name_in_owner = true
y_sort_enabled = true
script = ExtResource("2_room")

[node name="Protagonista" parent="World" instance=ExtResource("3_hero")]
unique_name_in_owner = true

[node name="Music" type="AudioStreamPlayer" parent="."]
unique_name_in_owner = true
process_mode = 3
stream = ExtResource("4_theme")
volume_db = -6.0

[node name="HUD" type="CanvasLayer" parent="."]

[node name="Hint" type="Label" parent="HUD"]
offset_left = 6.0
offset_top = 344.0
offset_right = 634.0
offset_bottom = 360.0
theme_override_colors/font_color = Color(0.8, 0.78, 0.9, 0.8)
theme_override_font_sizes/font_size = 9
text = "WASD / Arrows: move   Shift: run   Space / J: magic   K: sword   Esc / X: menu"

[node name="PauseMenu" parent="." instance=ExtResource("5_menu")]
unique_name_in_owner = true
